# Dev database (e2e and `npm run dev` use this; unit tests use roznamah_test via vitest config)
DATABASE_URL=postgresql://roznamah:roznamah@localhost:5432/roznamah
# Canonical public origin: required in production. Admin magic links and CSRF origin checks use it (AUTH_URL is derived from it).
APP_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=Roznamah <no-reply@example.com>
ADMIN_EMAILS=admin@example.com
AUTH_SECRET=change-me
# Dev only: log admin magic links to the server console instead of emailing (ignored in production)
EMAIL_TRANSPORT=
RENDER_SECRET=change-me
UPLOAD_DIR=./var/uploads
FILES_DIR=./var/files
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
LEAD_NOTIFY_EMAILS=
