# Dev database (e2e and `npm run dev` use this; unit tests use roznamah_test via vitest config)
DATABASE_URL=postgresql://roznamah:roznamah@localhost:5432/roznamah
# Canonical public origin: required in production. Admin magic links and CSRF origin checks use it (AUTH_URL is derived from it).
APP_URL=http://localhost:3000
# Email (production needs one driver; never sends from a placeholder). EMAIL_FROM is required in production.
EMAIL_FROM=Roznamah <no-reply@example.com>
# graph | resend | memory. Empty = graph when MS_TENANT_ID, MS_CLIENT_ID and MS_CLIENT_SECRET are all set,
# else resend when RESEND_API_KEY is set. memory is ignored in production.
MAIL_DRIVER=
# Recommended: Microsoft 365 via Microsoft Graph. An Entra ID app registration with the Mail.Send
# *application* permission (admin consent), ideally limited to the sender mailbox by an Exchange
# Application Access Policy. Graph sends as MAIL_GRAPH_SENDER (empty = the address in EMAIL_FROM);
# recipients see that mailbox's display name, not the name in EMAIL_FROM.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MAIL_GRAPH_SENDER=
# true = keep a copy of every system mail in the sender's Sent Items (default false)
MAIL_SAVE_TO_SENT=
# Tests only (fake Graph server); ignored in production
MS_LOGIN_BASE_URL=
MS_GRAPH_BASE_URL=
# Alternative: Resend (EMAIL_FROM on a Resend-verified domain)
RESEND_API_KEY=
ADMIN_EMAILS=admin@example.com
AUTH_SECRET=change-me
RENDER_SECRET=change-me
# Origin the worker's Chromium loads the print route from (the URL carries RENDER_SECRET). Defaults to
# APP_URL; production compose sets http://app:3000 so the secret never goes through the public URL.
RENDER_BASE_URL=
UPLOAD_DIR=./var/uploads
FILES_DIR=./var/files
# Client IP: the n-th X-Forwarded-For entry from the right (1 = the address Traefik appended)
TRUSTED_PROXY_HOPS=1
# Only when Cloudflare proxies the site: trust its CF-Connecting-IP header
TRUST_CF_CONNECTING_IP=false
# Cloudflare Turnstile: set BOTH for public launch, or neither (check off). Only one = downloads refused + startup CONFIG ERROR.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
LEAD_NOTIFY_EMAILS=
# memory = record emails in-process (tests; exposes GET /api/test/outbox outside production; same as
# MAIL_DRIVER=memory). Without any driver outside production, mail and admin magic links are logged to the console.
EMAIL_TRANSPORT=
# Address shown on /privacy for data-deletion requests (required in production)
PRIVACY_EMAIL=
